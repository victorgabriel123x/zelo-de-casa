# Zelo de Casa | variaveis de ambiente
# Copie para .env.local e preencha. Nenhum segredo deve ir para o repositorio.
# Sem as chaves de pagamento a loja roda em modo demonstracao, sem cobrar
# e sem enviar mensagens.

# Endereco publico do site, usado em links de e-mail e metadados
NEXT_PUBLIC_SITE_URL=https://substitua-pelo-seu-dominio

# ---------------------------------------------------------------- Supabase --
SUPABASE_URL=substitua
SUPABASE_SERVICE_ROLE_KEY=substitua
SUPABASE_BUCKET_NOTAS=notas-fiscais

# ------------------------------------------------------------------- Asaas --
# sandbox ou producao
ASAAS_AMBIENTE=sandbox
ASAAS_API_KEY=substitua
# token definido no cadastro do webhook dentro do painel do Asaas
ASAAS_WEBHOOK_TOKEN=substitua

# ------------------------------------------------------------------ Resend --
RESEND_API_KEY=substitua
EMAIL_REMETENTE=Zelo de Casa <pedidos@substitua-pelo-seu-dominio>
EMAIL_ADMIN=contato@vlds.com.br

# -------------------------------------------------------- WhatsApp Cloud API --
WHATSAPP_TOKEN=substitua
WHATSAPP_PHONE_NUMBER_ID=substitua

# ------------------------------------------------------------------ Painel --
ADMIN_EMAIL=contato@vlds.com.br
# gere com: npm run hash-admin "sua senha longa"
ADMIN_SENHA_HASH=substitua
# segredo aleatorio para assinar cookies: openssl rand -base64 48
SEGREDO_SESSAO=substitua
# segredo do agendamento que processa a fila de notificacoes
CRON_SEGREDO=substitua

# ------------------------------------------------------------------ Medicao --
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ------------------------------------------------- Identificacao do vendedor --
# Obrigatorios antes de publicar. Sem eles as paginas legais exibem pendencia.
FORNECEDOR_NOME=
FORNECEDOR_DOCUMENTO=
FORNECEDOR_ENDERECO=
FORNECEDOR_MUNICIPIO=
FORNECEDOR_ESTADO=Maranhão
# prazo contratual conferido no certificado do fabricante, em meses
GARANTIA_CONTRATUAL_MESES=
# frase sobre retencao e exclusao de dados
POLITICA_RETENCAO=
# regiao de armazenamento e transferencias internacionais
REGIAO_DADOS=

# --------------------------------------------------------------- Operacao ---
# true pausa as vendas sem tirar o site do ar
VENDAS_PAUSADAS=false
